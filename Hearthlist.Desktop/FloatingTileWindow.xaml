<Window x:Class="Hearthlist.Desktop.FloatingTileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hearthlist tile"
        Width="260"
        Height="170"
        MinWidth="140"
        MinHeight="90"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStartupLocation="Manual"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseMove="Window_MouseMove"
        MouseLeftButtonUp="Window_MouseLeftButtonUp">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Hearthlist.Desktop;component/Themes/TileTheme.Slate.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Border x:Name="TileSurface"
                Background="{DynamicResource TileCardBackgroundBrush}"
                BorderBrush="{DynamicResource TileCardBorderBrush}"
                BorderThickness="1"
                CornerRadius="16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="8" Direction="270" Opacity="0.48" Color="#000000"/>
            </Border.Effect>
        </Border>
        <Border x:Name="AccentRim"
                Margin="1"
                BorderBrush="{DynamicResource TileAccentBrush}"
                BorderThickness="1"
                CornerRadius="15"
                IsHitTestVisible="False"
                Opacity="0.56"/>
        <Border x:Name="GlowRim"
                Margin="1"
                BorderBrush="{DynamicResource TileAccentSoftBrush}"
                BorderThickness="3"
                CornerRadius="15"
                IsHitTestVisible="False"
                Opacity="0.58"
                Visibility="Collapsed">
            <Border.Effect>
                <BlurEffect Radius="7"/>
            </Border.Effect>
        </Border>
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="#FF625F" Margin="0,0,5,0"/>
                    <Ellipse Width="8" Height="8" Fill="#F5C451" Margin="0,0,5,0"/>
                    <Ellipse Width="8" Height="8" Fill="#42C977" Margin="0,0,10,0"/>
                    <TextBlock x:Name="TileTitle"
                               Text="Note"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TileAccentBrush}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
            <TextBlock x:Name="TileText"
                       Grid.Row="1"
                       FontFamily="Cascadia Mono, Consolas"
                       FontSize="12"
                       Foreground="{DynamicResource TileTextBrush}"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis"
                       IsHitTestVisible="False"/>
        </Grid>
    </Grid>
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Edit note" Click="EditNote_Click"/>
            <MenuItem Header="Tile settings..." Click="TileSettings_Click"/>
            <Separator/>
            <MenuItem Header="Remove tile" Click="RemoveTile_Click"/>
        </ContextMenu>
    </Window.ContextMenu>
</Window>