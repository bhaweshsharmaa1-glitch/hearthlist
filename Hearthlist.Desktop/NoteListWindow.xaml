<Window x:Class="Hearthlist.Desktop.NoteListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hearthlist Tiles"
        Width="470"
        SizeToContent="Height"
        MinHeight="320"
        MaxHeight="620"
        Background="#0E1118"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    <Border BorderBrush="#262B36" BorderThickness="1" CornerRadius="16" Padding="22">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="HEARTHLIST" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TileAccentBrush}"/>
                <TextBlock Text="Floating notes" Margin="0,5,0,0" FontSize="24" FontWeight="SemiBold" Foreground="#F2F4F8"/>
                <TextBlock Text="Each tile is its own window. The desktop stays open around it." Margin="0,5,0,0" TextWrapping="Wrap" Foreground="#929AA8"/>
            </StackPanel>
            <Button x:Name="NewButton" Grid.Row="1" Content="+ New tile" Height="44" Margin="0,0,0,12"
                    Background="{DynamicResource TileAccentBrush}" Foreground="#090A0D" BorderThickness="0"
                    FontSize="14" FontWeight="SemiBold" Click="NewButton_Click"/>
            <Grid Grid.Row="2" Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="148"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Default theme for new tiles" Foreground="#AAB2BF" Margin="0,0,0,6"/>
                    <TextBlock Text="Existing tiles keep their own theme." FontSize="11" Foreground="#788291" TextWrapping="Wrap"/>
                </StackPanel>
                <ComboBox x:Name="ThemeSelector" Grid.Column="1" VerticalAlignment="Center" Padding="8,6"
                          Background="#191D26" Foreground="#E9EDF4" BorderBrush="#343A46"/>
            </Grid>
            <Button x:Name="MovementAreaButton" Grid.Row="3" Content="Adjust movement area..." Height="38"
                    HorizontalAlignment="Left" Padding="13,6" Margin="0,0,0,16"
                    Background="#191D26" Foreground="#DAE0E9" BorderBrush="#343A46"
                    Click="MovementAreaButton_Click"/>
            <Border Grid.Row="4" Background="#151922" BorderBrush="#272D38" BorderThickness="1" CornerRadius="10" Padding="12">
                <StackPanel>
                    <TextBlock Text="Tile controls" FontWeight="SemiBold" Foreground="#DDE2EA"/>
                    <TextBlock Text="Drag to move and toss. Double-click to edit. Right-click for tile settings or removal."
                               Margin="0,5,0,0" FontSize="12" Foreground="#929AA8" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>