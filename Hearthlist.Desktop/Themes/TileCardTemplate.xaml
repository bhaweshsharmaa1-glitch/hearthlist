<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:models="clr-namespace:Hearthlist.Backend.Models;assembly=Hearthlist.Backend">
    <DataTemplate x:Key="TileCardTemplate" DataType="{x:Type models:Tile}">
        <Border Background="{DynamicResource TileCardBackgroundBrush}"
                BorderBrush="{DynamicResource TileCardBorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22"
                                  ShadowDepth="5"
                                  Direction="270"
                                  Opacity="0.32"
                                  Color="#000000"/>
            </Border.Effect>
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,10,0">
                        <Ellipse Width="8" Height="8" Fill="#FF625F" Margin="0,0,5,0"/>
                        <Ellipse Width="8" Height="8" Fill="#F5C451" Margin="0,0,5,0"/>
                        <Ellipse Width="8" Height="8" Fill="#42C977"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Text="{Binding Title}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TileAccentBrush}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Text="{Binding Text}"
                           FontFamily="Cascadia Mono, Consolas"
                           FontSize="12"
                           Foreground="#D7E0EC"
                           LineHeight="18"
                           MaxHeight="72"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </DataTemplate>
</ResourceDictionary>