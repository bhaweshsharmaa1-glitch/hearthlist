<Window x:Class="Hearthlist.Desktop.NoteEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Note"
        Width="520"
        Height="440"
        MinWidth="260"
        MinHeight="200"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Border Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource SurfaceAltBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="NOTEPAD"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="Quick note"
                                   Margin="0,3,0,0"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"/>
                    </StackPanel>
                    <TextBlock x:Name="SaveStatus"
                               Text="Saved on this device"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}"/>
                </Grid>
                <TextBox x:Name="EditorTextBox"
                         Grid.Row="1"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         Background="{StaticResource BackgroundBrush}"
                         BorderBrush="{StaticResource SurfaceAltBrush}"
                         BorderThickness="1"
                         CaretBrush="{StaticResource AccentBrush}"
                         FontSize="15"
                         Foreground="{StaticResource TextBrush}"
                         MaxLength="500000"
                         Padding="12"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         TextChanged="EditorTextBox_TextChanged">
                    <TextBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Undo" Command="{x:Static ApplicationCommands.Undo}"
                                      CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="Redo" Command="{x:Static ApplicationCommands.Redo}"
                                      CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <Separator/>
                            <MenuItem Header="Cut" Command="{x:Static ApplicationCommands.Cut}"
                                      CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="Copy" Command="{x:Static ApplicationCommands.Copy}"
                                      CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="Paste" Command="{x:Static ApplicationCommands.Paste}"
                                      CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <Separator/>
                            <MenuItem Header="Select all" Command="{x:Static ApplicationCommands.SelectAll}"
                                      CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        </ContextMenu>
                    </TextBox.ContextMenu>
                </TextBox>
            </Grid>
        </Border>
    </Grid>
</Window>