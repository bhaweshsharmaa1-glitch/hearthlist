<Window x:Class="Hearthlist.Desktop.EditTaskDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Task" Height="240" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">

    <StackPanel Margin="20">
        <TextBlock Text="Edit task" FontSize="18" FontWeight="Bold"
                   Foreground="{StaticResource TextBrush}" Margin="0,0,0,16"/>

        <TextBlock Text="Title" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
        <TextBox x:Name="TitleInput" Margin="0,4,0,12" Padding="8,6"
                 Foreground="{StaticResource TextBrush}"
                 Background="{StaticResource SurfaceBrush}"
                 BorderBrush="{StaticResource SurfaceAltBrush}"
                 BorderThickness="1" FontSize="14"/>

        <TextBlock Text="Description (optional)" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
        <TextBox x:Name="DescInput" Margin="0,4,0,18" Padding="8,6"
                 Foreground="{StaticResource TextBrush}"
                 Background="{StaticResource SurfaceBrush}"
                 BorderBrush="{StaticResource SurfaceAltBrush}"
                 BorderThickness="1" FontSize="14" KeyDown="Input_KeyDown"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Margin="0,0,10,0" Padding="14,7" Cursor="Hand"
                    Background="Transparent" Foreground="{StaticResource TextMutedBrush}"
                    BorderThickness="0" Click="Cancel_Click"/>
            <Button Content="Save" Padding="18,7" Cursor="Hand" FontWeight="SemiBold"
                    Background="{StaticResource AccentBrush}" Foreground="#201500"
                    BorderThickness="0" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
